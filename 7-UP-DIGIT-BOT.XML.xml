import random
import logging
from dataclasses import dataclass
from typing import List, Dict, Optional

@dataclass
class TradeConfig:
    """Configuration for trading strategy"""
    market: str = 'synthetic_index'
    submarket: str = 'random_index'
    symbol: str = 'R_100'
    trade_type: str = 'DIGITOVER'
    
    # Risk Management Parameters
    initial_amount: float = 0.37
    max_consecutive_losses: int = 5
    stop_loss_threshold: float = 500
    expected_profit: float = 5
    
    # Martingale Settings
    martingale_multiplier: float = 1.3
    base_prediction: int = 2

class TradingBot:
    def __init__(self, config: TradeConfig):
        self.config = config
        self.consecutive_losses = 0
        self.current_amount = config.initial_amount
        self.total_profit = 0
        self.current_prediction = config.base_prediction
        
        # Setup logging
        logging.basicConfig(level=logging.INFO, 
                            format='%(asctime)s - %(levelname)s: %(message)s')
        self.logger = logging.getLogger(__name__)

    def calculate_trade_amount(self) -> float:
        """Dynamically calculate trade amount based on consecutive losses"""
        if self.consecutive_losses >= self.config.max_consecutive_losses:
            # Reset strategy after max consecutive losses
            self.reset_strategy()
        
        # Increase amount with martingale multiplier
        current_amount = self.current_amount * (self.martingale_multiplier ** self.consecutive_losses)
        return round(current_amount, 2)

    def process_trade_result(self, is_win: bool):
        """Process trade result and update strategy"""
        trade_amount = self.calculate_trade_amount()
        
        if is_win:
            self.logger.info(f"✅ Trade Won! Amount: ${trade_amount}")
            self.consecutive_losses = 0
            self.current_amount = self.config.initial_amount
            self.total_profit += trade_amount
        else:
            self.logger.warning(f"❌ Trade Lost. Amount: ${trade_amount}")
            self.consecutive_losses += 1
            self.current_amount = trade_amount

        # Check for stop loss
        if abs(self.total_profit) >= self.config.stop_loss_threshold:
            self.logger.critical("Stop Loss Triggered! Halting trading.")
            self.reset_strategy()

    def reset_strategy(self):
        """Reset all trading parameters"""
        self.consecutive_losses = 0
        self.current_amount = self.config.initial_amount
        self.current_prediction = self.config.base_prediction
        self.total_profit = 0
        self.logger.info("Strategy Reset: All parameters restored to initial state.")

    def simulate_trade(self) -> bool:
        """Simulate a trade with randomized win/loss"""
        # This is a simulation. Replace with actual trading logic
        win_probability = 0.5  # 50% win chance
        return random.random() < win_probability

    def run_trading_session(self, num_trades: int = 10):
        """Run a complete trading session"""
        self.logger.info(f"Starting Trading Session: {num_trades} trades")
        
        for trade_num in range(1, num_trades + 1):
            self.logger.info(f"\n--- Trade {trade_num} ---")
            trade_amount = self.calculate_trade_amount()
            trade_result = self.simulate_trade()
            
            self.process_trade_result(trade_result)
            
            if abs(self.total_profit) >= self.config.stop_loss_threshold:
                break

        self.logger.info(f"Trading Session Complete. Total Profit: ${self.total_profit}")

def main():
    config = TradeConfig(
        initial_amount=0.37,
        max_consecutive_losses=5,
        stop_loss_threshold=500,
        expected_profit=5
    )
    
    bot = TradingBot(config)
    bot.run_trading_session()

if __name__ == "__main__":
    main()
